# ─── SIMMOON — Variables de Entorno ──────────────────────────────────
# Copia este archivo como .env y completa los valores.
# .env está en .gitignore para no subir secretos.

# VOTE_API_KEY para el servidor Python vote_api.py (puerto 9099)
# El viewer.html usa Simmoon_arc/vote_config.js (no versionado) como alternativa local.
# Ambas deben coincidir para que el viewer pueda votar.
VOTE_API_KEY=dev_placeholder_change_me

# Obsidian REST API (opcional, para memoria persistente)
# Config en Simmoon_arc/obsidian_rest_config.json
OBSIDIAN_REST_URL=https://127.0.0.1:27124
OBSIDIAN_API_KEY=

# PostgreSQL (opcional)
PGHOST=localhost
PGPORT=5432
PGDATABASE=simmoon
PGUSER=postgres
PGPASSWORD=
