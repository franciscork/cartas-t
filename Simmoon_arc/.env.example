# =============================================================================
#  SIMMOON Telegram Bot — Variables de Entorno
# =============================================================================
# Copia este archivo como .env y completa los valores, o establece
# las variables directamente en tu terminal.
#
# PowerShell:
#   $env:TELEGRAM_BOT_TOKEN = "tu_token_aqui"
#
# CMD:
#   set TELEGRAM_BOT_TOKEN=tu_token_aqui
#
# Git Bash / WSL2:
#   export TELEGRAM_BOT_TOKEN="tu_token_aqui"
# =============================================================================

# Token del bot de Telegram (obtén uno de @BotFather en https://t.me/BotFather)
# Este token tiene prioridad sobre telegram_config.json
TELEGRAM_BOT_TOKEN=

# Opcional: Modelo y URL de Ollama
# OLLAMA_MODEL=qwen25-64k
# OLLAMA_URL=http://127.0.0.1:11434
