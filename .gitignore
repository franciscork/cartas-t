# ─── Secretos / Config local ─────────────────────────────
# Obsidian REST API key (contiene API key real)
Simmoon_arc/obsidian_rest_config.json

# API key de votación local
Simmoon_arc/vote_config.js

# Token de Telegram (contiene token real del bot)
Simmoon_arc/telegram_config.json

# Estado de conversación de Buffy Telegram (se regenera automáticamente)
Simmoon_arc/buffy_telegram_state.json

# Base de datos runtime de HERA (cola de tareas SQLite)
Simmoon_arc/hera_tasks.db

# Estado de conversación del agente Telegram HERA (se regenera)
Simmoon_arc/hera_telegram_state.json

# ─── Logs ─────────────────────────────────────────────────
